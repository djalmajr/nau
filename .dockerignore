# Version control and agent state.
.git
.soho
.agents

# CI configuration: not part of the build.
.github

# Documentation and design: not part of the build.
*.md
design
docs

# Install scripts and their (large) testdata: not part of the build.
scripts

# Web: only the sources enter the build.
web/node_modules
web/dist

# Local environment and credential files never enter the build
# context, in any folder (Vite reads .env.local and .env.*.local).
**/.env
**/.env.*
**/*.pem
**/*.key
